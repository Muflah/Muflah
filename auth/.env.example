# Muflah Auth environment configuration
# Copy this file to .env for local development, then replace placeholders.

# Database / Better Auth
DATABASE_URL=postgresql://user:password@host:5432/database
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Email delivery (Resend)
# This domain must be verified in Resend. Sender aliases are generated by the app.
AUTH_EMAIL_DOMAIN=mail.muflah.com
EMAIL_API_KEY=

# Authentication behavior
# OTP is enabled unless this is explicitly set to false.
AUTH_OTP_ENABLED=true
# OTP lifetime in minutes; the application default is 3.
AUTH_OTP_EXPIRES_IN_MINUTES=3
AUTH_OTP_MAX_ATTEMPTS=3

# Maximum active account sessions per browser/device. Values outside 1-10 default to 1.
AUTH_MAX_SESSIONS=4
